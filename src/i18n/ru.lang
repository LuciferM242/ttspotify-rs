# Help text
#
# One entry per help topic. Long lines: \n marks a line break in the
# message the user sees. Command names and their arguments stay in English,
# because they are what the user has to type.

# The main help listing: playback, queue and mode sections.
help_overview_playback = Воспроизведение:\n  p <запрос>     Найти и включить трек, плейлист или альбом\n  p               Пауза или продолжение\n  s               Остановить и очистить очередь\n  n               Следующий трек\n  o               Предыдущий трек\n  replay          Начать трек заново\n  c               Информация о текущем треке\n\nОчередь:\n  queue           Показать очередь\n  queue clear     Удалить предстоящие треки\n  queue rm <N>    Удалить предстоящий трек номер N\n\nРежимы:\n  mode [r|rq|off]     Режим повтора\n  shuffle [on|off]    Перемешать предстоящие треки

# Extra help lines shown only when Spotify is the active service.
help_overview_spotify =   radio [on|off]      Включить радио (автоматические рекомендации)\n  liked               Включить любимые треки (также: fav)

# The rest of the main help listing: audio, search, service, bot.
help_overview_rest = \nЗвук:\n  v [0-100]       Показать или изменить громкость\n  sf/sb [N]       Перемотать вперёд или назад на N секунд\n\nПоиск:\n  search <запрос>  Найти и выбрать из результатов\n  <номер>         Выбрать результат\n  a / cancel      Отменить поиск\n\nСервис:\n  /sp             Переключиться на Spotify\n  /yt             Переключиться на YouTube\n\nБот:\n  link         Ссылка на текущий трек\n  stats        Время работы и статистика сессии\n  lang         Показать или выбрать язык\n  cn <имя>     Изменить имя бота\n  gender       Пол бота\n  info         Информация о боте

# Help lines shown only to admins.
help_overview_admin =   jc <путь>    Зайти в канал\n  glang        Язык сервера по умолчанию\n  rs           Перезапустить\n  q            Выключить

# End of the main help listing. {service} = the active service name.
help_overview_footer = \nАктивный сервис: {service}\nНапишите h <команда> для подробной справки (например h queue)

# Shown for an unrecognised command or help topic.
help_unknown = Неизвестная команда. Напишите h для списка команд.

help_play = p / play\n  p <запрос>    Найти и включить первый результат.\n                Если уже играет, трек добавится в очередь.\n                Принимает названия, ссылки на треки, плейлисты и альбомы.\n  p             Без запроса переключает паузу и воспроизведение.\nПримеры:\n  p photograph\n  p spotify:track:6rqhFgbbKwnb9MLmUQDhG6

help_stop = s / stop\nОстановить воспроизведение и очистить очередь.

help_next = n / next\nПерейти к следующему треку.\nЕсли радио включено и ничего не осталось, бот запросит рекомендации.

help_prev = o / prev\nВернуться к предыдущему треку.\nПосле 3 секунд трека команда начинает его заново; нажмите ещё раз, чтобы вернуться назад. Команда replay всегда начинает заново.

help_replay = replay / rp\nНачать текущий трек с начала.

help_current = c / current\nПоказать текущий трек с позицией, длительностью и активными режимами.

help_queue = queue\n  queue          Показать текущий трек и то, что дальше.\n  queue clear    Удалить все предстоящие треки, оставив текущий.\n  queue rm <N>   Удалить предстоящий трек под номером N.\n                 N=1 это трек после текущего.\nУже сыгранные треки не показываются.\nПримеры:\n  queue rm 1     Удалить следующий предстоящий трек\n  queue rm 3     Удалить третий предстоящий трек\n  queue clear    Удалить всё после текущего трека

help_mode = mode [r|rq|off]\n  mode r     Повторять текущий трек\n  mode rq    Повторять всю очередь\n  mode off   Выключить повтор\n  mode       Показать активные режимы\nПеремешивание отдельно: смотрите 'h shuffle'.

help_shuffle = shuffle [on|off]\n  shuffle       Включить или выключить перемешивание\n  shuffle on    Включить\n  shuffle off   Выключить\nПеремешивает предстоящие треки, сохраняя порядок тех, что вы заказали по названию. Работает вместе с повтором.

help_volume = v / volume [0-100]\n  v          Показать текущую громкость\n  v 50       Установить громкость 50%\n  v50        Установить 50% (без пробела)\n  volume 30  Установить 30%\nГромкость ограничена настроенным максимумом.

help_seek = sf / sb [секунды]\n  sf         Перемотать вперёд на 10 секунд\n  sb         Перемотать назад на 10 секунд\n  sf30       Перемотать вперёд на 30 секунд\n  sb 5       Перемотать назад на 5 секунд

help_search = search <запрос>\n  Найти и показать результаты. Затем:\n  <номер>    Выбрать результат для воспроизведения или очереди\n  a / cancel Убрать результаты\nПример:\n  search photograph\n  2          Включить второй результат

help_radio = radio [on|off]\n  radio on   Включить радио. Когда одиночный трек заканчивается\n             и ничего не осталось, бот сам находит\n             рекомендации по последнему треку.\n             Для плейлистов и альбомов не срабатывает.\n  radio off  Выключить радио.\n  radio      Показать состояние радио.

help_link = link / url\nПолучить ссылку на текущий трек.\nОткройте её в приложении сервиса или поделитесь с другими.

help_stats = stats\nВремя работы бота, сыгранные треки за сессию, длина очереди и громкость.

help_jc = jc <путь>\nЗайти в канал TeamTalk по пути.\nПример: jc /Music Room

help_lang = lang [код]\nПоказать доступные языки или выбрать свой.\nВыбор запоминается по имени пользователя.\nlang clear убирает ваш выбор (используется язык сервера).\nПример: lang de

help_glang = glang <код>\nУстановить язык сервера по умолчанию (для администратора).\nУ тех, кто выбрал язык командой lang, он сохранится.

help_cn = cn <имя>\nИзменить имя бота.\nПример: cn DJ Bot

help_gender = gender <male|female|neutral>\nУстановить пол бота (влияет на значок в TT).\nСокращения: m, f, n, man, woman, nb

help_service = /sp / /yt\n  /sp     Переключить активный сервис на Spotify.\n  /yt     Переключить активный сервис на YouTube.\nКоманды p, search, n, o работают с активным сервисом.\nПереключение не прерывает воспроизведение. Для остановки используйте s.

help_restart = rs / restart\nПерезапустить бота. Настройки сохраняются перед выходом.

help_quit = q / quit\nВыключить бота. Настройки сохраняются перед выходом.
